# ---------------------------------------------------------------------------
# HookMerge AI — environment configuration
# Copy this file to .env.local and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# SQLite database file used by the built-in node:sqlite driver.
DATABASE_URL=file:./data/hookmerge.db

# Server secret used to hash license keys (pepper) and sign session material.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LICENSE_SECRET=

# Admin console password. Admin login is completely separate from license access.
ADMIN_SECRET=

# 32-byte (hex or passphrase) key used to encrypt user AI API keys at rest.
ENCRYPTION_KEY=

# Optional one-time bootstrap owner license. Generate a unique random value,
# use it only for the first owner login, then remove it after creating invites.
INITIAL_LICENSE_KEY=

# Used by docker-compose Caddy for automatic HTTPS.
DOMAIN=your-domain.example

# Uploads directory (local object storage). Absolute path or relative to project root.
STORAGE_DIR=./storage

# Max upload size in megabytes.
MAX_UPLOAD_MB=200

# Public origin, used for links/cookies in production.
NEXT_PUBLIC_APP_URL=https://your-domain.example
